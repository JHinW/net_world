# ==============================================================================
# net_world (mesh-bridge) 环境变量配置示例
# 使用方式:
#   cp .env.example .env.custom
#   ./net_world --env-file=.env.custom
#   或: TAILCAT_ENV_FILE=.env.custom ./net_world
# ==============================================================================

# --- 基础网关与身份密钥 ---
# 服务端默认监听端口 (等价于 `bridge <port>`，默认 19100)
TAILCAT_BRIDGE_PORT=19100

# 服务端身份密钥路径或名称 (等价于 --key；未设置 TAILCAT_CLIENT_KEY 时也作客户端回退)
# TAILCAT_KEY=default

# 客户端身份密钥路径或名称 (等价于 --client-key)
# TAILCAT_CLIENT_KEY=client-default

# 是否开启详细日志 (1 或 true 等价于 -v/--verbose)
TAILCAT_VERBOSE=false

# 自定义 DERP Map URL (等价于 --derpmap-url)
# TAILCAT_DERPMAP_URL=https://controlplane.tailscale.com/derpmap/default

# 启动后将服务端 tc 地址写入文件或发送到 TCP 端点 (等价于 --addr-file)
# TAILCAT_ADDR_FILE=/tmp/mesh-bridge.addr
# TAILCAT_ADDR_FILE=tcp:127.0.0.1:19200

# --- 入站端口与访问控制 ---
# 额外暴露的本地 TCP 端口 (支持逗号分隔、范围如 8000-8010 或 all；等价于 --serve-ports)
# TAILCAT_SERVE_PORTS=8080,9000-9005

# 允许接入的客户端节点公钥列表 (逗号分隔的 nodekey:...；等价于 --allow)
# TAILCAT_ALLOW_CLIENTS=nodekey:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SSH 配置 ---
# 入站 22 端口 SSH 模式: builtin | local | off (默认 builtin；等价于 --ssh-mode)
TAILCAT_SSH_MODE=builtin

# 允许的 SSH 公钥来源 (逗号分隔的 authorized_keys 路径、公钥字符串或 user@github；等价于 --ssh-authorized-keys)
# TAILCAT_SSH_AUTHORIZED_KEYS=~/.ssh/authorized_keys

# 仅 builtin SSH 模式有效：当未配置授权公钥时，设为 1 允许无认证接入 (生产环境不建议)
# TAILCAT_SSH_ALLOW_UNAUTHENTICATED=0

# `ssh` 子命令使用的客户端 SSH 私钥路径 (默认自动探测 .mesh/ssh_id_ed25519；等价于 -i/--identity)
# TAILCAT_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
